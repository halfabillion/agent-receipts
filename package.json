{
  "name": "agent-receipts",
  "version": "1.0.0",
  "description": "Evidence-grade receipts for AI-agent stablecoin (x402) payments: Chainlink-valued, terms-pinned, VAT-aware, independently verifiable.",
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "vitest run",
    "demo": "tsx src/cli.ts demo",
    "verify": "tsx src/cli.ts verify",
    "test:live": "LIVE=1 vitest run",
    "test:contracts": "cd contracts && forge test",
    "test:fork": "cd contracts && forge test --fork-url https://mainnet.base.org --match-contract Fork"
  },
  "keywords": [
    "x402",
    "chainlink",
    "legal-tech",
    "receipts",
    "ai-agents",
    "base",
    "usdc",
    "vat"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "express": "^4.22.3",
    "viem": "^2.57.10"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "bin": {
    "agent-receipts": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./dist/receipt.js",
    "./x402": "./dist/x402.js",
    "./server": "./dist/server.js"
  }
}